FROM node:22.23.5-alpine3.24@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a

USER root

RUN apk add --no-cache 'zlib>=1.4-r0' git

RUN npm install --global esbuild@0.28.1 \
    && npm cache clean --force \
    && NPM_ROOT="$(npm root -g)" \
    && rm -rf "$NPM_ROOT/npm" /usr/local/bin/npm /usr/local/bin/npx /root/.npm /home/node/.npm

ENV HOME=/tmp
WORKDIR /workspace

USER 65532:65532
